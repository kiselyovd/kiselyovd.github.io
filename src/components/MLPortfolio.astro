---
import PortfolioRow from './PortfolioRow.astro';

import artifacts from '../data/ml-artifacts.json';

const rows = artifacts.rows;
---

<section id="portfolio" class="fade-in px-6 md:px-10 py-16 md:py-20 border-b border-[color:var(--border)]">
  <span class="section-label block mb-3" data-i18n="port.label">/ Open-source ML portfolio</span>
  <h2
    class="text-[22px] md:text-[28px] font-bold tracking-[-0.02em] leading-[1.1] text-[color:var(--text)] mb-3 max-w-3xl"
    data-i18n="port.heading"
  >
    Applied ML projects and the engineering scaffold behind them
  </h2>
  <p class="text-[12px] md:text-[13px] text-[color:var(--text-muted)] leading-[1.55] mb-3 max-w-3xl" data-i18n="port.intro"></p>
  <p class="text-[12px] text-[color:var(--text-muted)]" data-i18n="port.collections">Browse the collections on Hugging Face:</p>
  <nav aria-label="Hugging Face Collections" class="flex flex-wrap gap-x-4 gap-y-1 text-[13px] mb-6">
    <a href="https://huggingface.co/collections/kiselyovd/vehicle-perception-and-synthetic-data" class="py-1 text-[color:var(--accent)] underline underline-offset-4">Vehicle Perception &amp; Synthetic Data</a>
    <a href="https://huggingface.co/collections/kiselyovd/medical-computer-vision" class="py-1 text-[color:var(--accent)] underline underline-offset-4">Medical Computer Vision</a>
    <a href="https://huggingface.co/collections/kiselyovd/applied-classification" class="py-1 text-[color:var(--accent)] underline underline-offset-4">Applied Classification</a>
  </nav>

  <div class="mt-8 mb-8 rounded-lg border border-[color:var(--border)] bg-[color:var(--surface)] p-4 md:p-6">
    <span class="section-label block mb-2" data-i18n="port.research.label">/ Research track</span>
    <h3 class="text-[16px] md:text-[20px] font-bold tracking-[-0.01em] text-[color:var(--text)] mb-4" data-i18n="port.research.heading">
      Synthetic data &amp; monocular 3D pose
    </h3>

    <div class="max-w-3xl mx-auto mb-5">
      <figure class="research-stage relative rounded-md overflow-hidden border border-[color:var(--border)] mb-2.5">
        <video
          src="/portfolio/synth-demo.mp4"
          poster="/portfolio/synth-hero.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="w-full block aspect-video object-cover"
        >
        </video>
        <figcaption
          class="absolute bottom-0 left-0 right-0 px-3 py-2 font-mono text-[9px] md:text-[10px] tracking-[0.08em] uppercase text-[color:var(--text)] bg-gradient-to-t from-black/75 to-transparent"
          data-i18n="port.research.cap.video"
        >
          Rendered in Epic UE5 City Sample - clean -&gt; 24-pt skeleton -&gt; wireframe
        </figcaption>
      </figure>

      <div class="grid grid-cols-3 gap-2 md:gap-2.5">
        <figure class="research-thumb rounded-md overflow-hidden border border-[color:var(--border)]">
          <img src="/portfolio/calibration.jpg" alt="Projected ground-truth box and keypoints on a synthetic vehicle" loading="lazy" class="w-full aspect-[16/10] object-cover" />
          <figcaption class="px-2 py-1.5 font-mono text-[8px] md:text-[9px] tracking-[0.06em] uppercase text-[color:var(--text-subtle)]" data-i18n="port.research.cap.detect">Keypoints + bbox</figcaption>
        </figure>
        <figure class="research-thumb rounded-md overflow-hidden border border-[color:var(--border)]">
          <img src="/portfolio/zonegraph.jpg" alt="Top-down road-lane sampling across the City Sample map" loading="lazy" class="w-full aspect-[16/10] object-cover" />
          <figcaption class="px-2 py-1.5 font-mono text-[8px] md:text-[9px] tracking-[0.06em] uppercase text-[color:var(--text-subtle)]" data-i18n="port.research.cap.lanes">Road sampling</figcaption>
        </figure>
        <figure class="research-thumb rounded-md overflow-hidden border border-[color:var(--border)]">
          <img src="/portfolio/synth-labels.jpg" alt="Projected synthetic keypoint labels" loading="lazy" class="w-full aspect-[16/10] object-cover" />
          <figcaption class="px-2 py-1.5 font-mono text-[8px] md:text-[9px] tracking-[0.06em] uppercase text-[color:var(--text-subtle)]" data-i18n="port.research.cap.labels">Synthetic labels</figcaption>
        </figure>
      </div>
    </div>

    <ul class="space-y-2 text-[12px] text-[color:var(--text-muted)] leading-[1.55] list-disc pl-4">
      <li>
        <a
          href="https://github.com/kiselyovd/ue5-vehicle-synth"
          target="_blank"
          rel="noopener"
          class="font-mono text-[color:var(--accent)] hover:underline"
        >
          ue5-vehicle-synth
        </a>
        <span data-i18n="port.research.synth"></span>
        <a
          href="https://huggingface.co/datasets/kiselyovd/citysample-vehicle-keypoints-24pt"
          target="_blank"
          rel="noopener"
          class="text-[color:var(--accent)] hover:underline"
          data-i18n="port.research.dataset"
        >
          HF dataset
        </a>
        <span data-i18n="port.research.docs.sep"> · </span>
        <a
          href="https://kiselyovd.github.io/ue5-vehicle-synth/"
          target="_blank"
          rel="noopener"
          class="text-[color:var(--accent)] hover:underline"
          data-i18n="port.research.docs"
        >
          Docs
        </a>
      </li>
      <li>
        <a
          href="https://huggingface.co/kiselyovd/citysample-vehicle-keypoints-24pt"
          target="_blank"
          rel="noopener"
          class="font-mono text-[color:var(--accent)] hover:underline"
        >
          citysample-vehicle-keypoints-24pt
        </a>
        <span data-i18n="port.research.model"></span>
      </li>
      <li><span data-i18n="port.research.pose3d">Monocular PnP companion with a separate ApolloCar3D evaluation.</span> <a href="https://kiselyovd.github.io/vehicle-keypoints/usage-guide/#monocular-3d-pose-pnp-baseline" class="text-[color:var(--accent)] hover:underline" data-i18n="port.research.poseeval">3D evaluation</a></li>
      <li><a href="https://kiselyovd.github.io/vehicle-keypoints/phase0/synthetic-pretraining/" class="text-[color:var(--accent)] hover:underline" data-i18n="port.research.transfer">Matched real-data transfer evaluation</a></li>
    </ul>
    <p class="mt-4 text-[12px] text-[color:var(--text-muted)]"><a href="https://kiselyovd.github.io/ue5-vehicle-synth/DATASET_LINEAGE/" class="text-[color:var(--accent)] hover:underline" data-i18n="port.research.lineage">Inspect the exact dataset/checkpoint split crosswalk</a></p>
    <p class="mt-5 text-[13px] text-[color:var(--text-muted)]" data-i18n="port.research.real">Try the separate main detector trained on real data:</p>
    <p class="mt-2 text-[13px]"><a href="https://huggingface.co/spaces/kiselyovd/vehicle-keypoints-demo" class="text-[color:var(--accent)] hover:underline" data-i18n="port.research.live">Run the 14-point detector on your image</a> · <a href="https://kiselyovd.github.io/vehicle-keypoints/showcase/" class="text-[color:var(--accent)] hover:underline" data-i18n="port.research.viewer">Annotation explorer</a> · <a href="https://kiselyovd.github.io/vehicle-keypoints/usage-guide/#results" class="text-[color:var(--accent)] hover:underline" data-i18n="port.research.eval">CarFusion evaluation</a></p>
  </div>

  <h3 id="model-evaluations" class="text-[16px] md:text-[20px] font-bold tracking-[-0.01em] text-[color:var(--text)] mb-3" data-i18n="port.models">Models &amp; evaluation</h3>
  <p class="text-[12px] text-[color:var(--text-muted)] mb-4" data-i18n="port.evidence.intro">Scores link to pinned evaluation records; replayed and historical results are labelled separately.</p>

  <table class="hidden md:table w-full border-collapse">
    <thead>
      <tr class="border-b border-[color:var(--border)]">
        <th class="text-left py-2 pr-4 font-mono text-[9px] tracking-[0.12em] uppercase text-[color:var(--text-subtle)] font-medium" data-i18n="port.col.repo">Repo</th>
        <th class="text-left py-2 pr-4 font-mono text-[9px] tracking-[0.12em] uppercase text-[color:var(--text-subtle)] font-medium" data-i18n="port.col.task">Task</th>
        <th class="text-left py-2 pr-4 font-mono text-[9px] tracking-[0.12em] uppercase text-[color:var(--text-subtle)] font-medium" data-i18n="port.col.model">Model</th>
        <th class="text-left py-2 font-mono text-[9px] tracking-[0.12em] uppercase text-[color:var(--text-subtle)] font-medium" data-i18n="port.col.metrics">Metrics</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => <PortfolioRow {...r} variant="desktop" />)}
    </tbody>
  </table>

  <div class="md:hidden space-y-2">
    {rows.map((r) => <PortfolioRow {...r} variant="mobile" />)}
  </div>

  <p class="mt-6 text-[12px] md:text-[13px] text-[color:var(--text-muted)] leading-[1.55] max-w-3xl">
    <span data-i18n="port.template.prefix">The applied projects share an engineering scaffold,</span>
    <a
      href="https://github.com/kiselyovd/ml-project-template"
      target="_blank"
      rel="noopener"
      class="font-mono text-[color:var(--accent)] hover:underline"
    >
      ml-project-template
    </a>
    <span data-i18n="port.template.suffix">, which wires the CI, quality gates, Docker, and docs pipeline before any model code is written.</span>
  </p>

  <p class="mt-3 text-[13px]"><a href="/showcase/ml-project-template/" class="text-[color:var(--accent)] hover:underline" data-i18n="port.template.explorer">Explore the scaffold</a></p>

</section>
